	)
	(text "Notes:\nWe call this +BATT and not 3.3V because \nthis will be pulled from \nthe battery, not the voltage regulator."
		(exclude_from_sim no)
		(at 114.046 34.29 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "7114bf7d-30c5-4c04-9aa7-e7397fb0229a")
	)
	(text "Flyback diode\nTo block the current when on\nWhen motor off, it lets the motor's\nflyback current go through itself again\nand not the MOSFET."
		(exclude_from_sim no)
		(at 88.646 52.07 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "88f2daad-57af-4ad7-a77a-68542803cdce")
	)
	(text "N channel mosfet (normally off)\nwill allow top to flow to bottom \nwhen gate is driven high"
